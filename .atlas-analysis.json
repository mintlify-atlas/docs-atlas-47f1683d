  "keyFeatures": [
    "Real-time scrap tracking with barcode scanner support",
    "Role-based access control with 4 permission levels",
    "Interactive dashboard with charts and analytics",
    "Configurable tolerance thresholds with alerts",
    "Comprehensive reporting by area, shift, and category",
    "Offline-first mode with localStorage fallback",
    "Multi-shift and production line management",
    "Audit logging for compliance tracking",
    "CSV import/export for data migration",
    "Docker-based deployment with MySQL backend"
  ],
